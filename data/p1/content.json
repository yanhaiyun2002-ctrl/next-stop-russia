      "speakerId": "anna",
      "speaker": "Анна · 安娜",
      "ru": "Привет! Я Анна. Добро пожаловать в Санкт-Петербург!",
      "zhSubtitle": "你好！我是安娜。欢迎来到圣彼得堡！"
    },
    {
      "id": "q00.anna.02",
      "speakerId": "anna",
      "speaker": "Анна · 安娜",
      "ru": "Наверное, дорога была долгой. Пойдём, я покажу тебе комнату.",
      "zhSubtitle": "一路辛苦了吧。走，我带你去看看房间。"
    },
    {
      "id": "q00.maria.01",
      "speakerId": "dorm_admin",
      "speaker": "Мария Ивановна · 宿舍管理员",
      "ru": "Здравствуйте! Вот ключ от вашей комнаты.",
      "zhSubtitle": "你好！这是你的房间钥匙。"
    },
    {
      "id": "q00.maria.02",
      "speakerId": "dorm_admin",
      "speaker": "Мария Ивановна · 宿舍管理员",
      "ru": "Если что-то понадобится, обращайтесь ко мне.",
      "zhSubtitle": "有什么需要，可以来找我。"
    },
    {
      "id": "q00.anna.03",
      "speakerId": "anna",
      "speaker": "Анна · 安娜",
      "ru": "Осмотрись пока. Позже я напишу тебе про университет.",
      "zhSubtitle": "你先熟悉一下房间。稍后我再发消息告诉你大学的事。"
    }
  ],
  "annaMessage": [
    {
      "id": "q03.anna.msg01",
      "speakerId": "anna",
      "speaker": "Анна · 安娜的消息",
      "ru": "Привет! В университете уже можно забрать пакет документов для регистрации.",
      "zhSubtitle": "嗨！现在可以去大学领取报到资料了。"
    },
    {
      "id": "q03.anna.msg02",
      "speakerId": "anna",
      "speaker": "Анна · 安娜的消息",
      "ru": "Загляни туда, когда будет время. Потом расскажешь, как всё прошло!",
      "zhSubtitle": "有空就去一趟吧。之后告诉我顺不顺利！"
    }
  ],
