# Godot generates this cache; keep .uid files for stable script references.
.godot/
.tools/
builds/
.local-dev/
/build/
/dist/
*.tmp
__pycache__/
*.pyc
export_credentials.cfg
# Local environment files and signing credentials must stay outside the baseline.
.env
.env.*
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.DS_Store
Thumbs.db
# Reference media is kept locally for analysis, never imported as game assets.
/docs/references/*.mp4
/docs/references/dorm_layout_camera_reference.jfif
/docs/evidence/p0-03r/reference_frames/

# Local test sessions are not source fixtures or publishable player data.
docs/evidence/**/player-data/
docs/evidence/**/data/
docs/evidence/**/bootstrap/

